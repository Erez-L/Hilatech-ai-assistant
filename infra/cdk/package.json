{
  "name": "@hilatech/infra-cdk",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK v2 (TypeScript) infrastructure for HilaTech AI Assistant. Standalone npm project (not part of the pnpm workspace).",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --all --quiet",
    "synth:dev": "cdk synth -c env=dev --all --quiet",
    "synth:staging": "cdk synth -c env=staging --all --quiet",
    "synth:prod": "cdk synth -c env=prod --all --quiet",
    "validate": "node scripts/validate-all.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "aws-cdk": "2.1148.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
