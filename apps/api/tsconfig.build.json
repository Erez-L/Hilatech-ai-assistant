    "noEmit": false,
    "rootDir": "src",
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test", "src/test-utils", "**/*.spec.ts"]
}
