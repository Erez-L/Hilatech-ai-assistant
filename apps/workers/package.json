{
  "name": "@hilatech/workers",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ workers (NestJS standalone application) consuming every queue in @hilatech/contracts",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --watch --watch-preserve-output -r ts-node/register/transpile-only src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@hilatech/ai-engine": "workspace:*",
    "@hilatech/contracts": "workspace:*",
    "@hilatech/database": "workspace:*",
    "@hilatech/shared": "workspace:*",
    "@hilatech/storage": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.4.0",
    "pdf-parse": "2.4.5",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hilatech/config": "workspace:*",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
