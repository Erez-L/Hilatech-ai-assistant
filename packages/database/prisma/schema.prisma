// HilaTech AI Assistant — relational schema (PostgreSQL + pgvector)
//
// Conventions
//  - Every organization-owned table has `organizationId` (NOT NULL, indexed, FK → Organization, cascade).
//  - IDs are UUIDs generated by the database.
//  - `createdAt` / `updatedAt` on every mutable entity.
//  - Soft deletion only where justified (Organization, Lead, Contact) via `deletedAt`.
//  - Tenant isolation is enforced in the API layer (TenantContext + repositories); these constraints are
//    the second line of defence.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  runtime  = "nodejs"
  moduleFormat = "cjs"
  generatedFileExtension = "ts"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String
  firstName       String    @db.VarChar(80)
  lastName        String    @db.VarChar(80)
  avatarUrl       String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true)
  /// UI/user preferences (theme, locale, notification preferences). Validated by the API.
  preferences     Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             OrganizationMember[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  identities              UserIdentity[]
  sentInvitations         Invitation[]             @relation("InvitationInviter")
  auditLogs               AuditLog[]
  notifications           Notification[]
  ownedContacts           Contact[]                @relation("ContactOwner")
  assignedLeads           Lead[]                   @relation("LeadAssignee")
  leadNotes               LeadNote[]
  assignedConversations   Conversation[]           @relation("ConversationAssignee")
  messages                Message[]
  usageRecords            UsageRecord[]
  assistantThreads        AssistantThread[]
  createdAgents           Agent[]                  @relation("AgentCreator")
  triggeredExecutions     AgentExecution[]         @relation("ExecutionTrigger")
  aiRequestLogs           AiRequestLog[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTasks            Task[]                   @relation("TaskCreator")
  ownedDeals              Deal[]                   @relation("DealOwner")
  ownedCompanies          Company[]                @relation("CompanyOwner")
  dealNotes               DealNote[]
  importJobs              ImportJob[]

  @@index([isActive])
}

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(50)
  industry    String?   @db.VarChar(100)
  timezone    String    @default("UTC") @db.VarChar(64)
  locale      String    @default("en") @db.VarChar(16)
  logoUrl     String?
  website     String?
  description String?
  /// Organization-specific settings (business hours, branding, AI defaults). Validated by the API.
  settings    Json      @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members       OrganizationMember[]
  roles         Role[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  usageRecords  UsageRecord[]
  budget        OrganizationBudget?
  budgetAlerts  BudgetAlert[]
  contacts      Contact[]
  leads         Lead[]
  conversations Conversation[]
  notifications Notification[]
  aiProviderConfigs AiProviderConfig[]
  aiRequestLogs     AiRequestLog[]
  promptTemplates   PromptTemplate[]
  assistantThreads  AssistantThread[]
  agents            Agent[]
  agentExecutions   AgentExecution[]
  knowledgeBases    KnowledgeBase[]
  documents         Document[]
  documentChunks    DocumentChunk[]
  workflows         Workflow[]
  workflowExecutions WorkflowExecution[]
  webhookEndpoints  WebhookEndpoint[]
  webhooks          Webhook[]
  webhookDeliveries WebhookDelivery[]
  integrations      Integration[]
  tasks             Task[]
  companies         Company[]
  pipelines         Pipeline[]
  pipelineStages    PipelineStage[]
  deals             Deal[]
  dealNotes         DealNote[]
  dealActivities    DealActivity[]
  dealStageChanges  DealStageChange[]
  importJobs        ImportJob[]
  evaluationDatasets EvaluationDataset[]
  evaluationRuns     EvaluationRun[]

  @@index([deletedAt])
}

enum MemberStatus {
  active
  suspended
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  status         MemberStatus @default(active)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@index([roleId])
}

/// Catalog of permission keys (`resource:action`). Seeded from @hilatech/contracts; used for validation and UI.
model Permission {
  key         String   @id @db.VarChar(80)
  group       String   @db.VarChar(40)
  description String?
  createdAt   DateTime @default(now())
}

/// Roles are per-organization. System roles (owner/admin/member) are created with the organization.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String   @db.VarChar(40)
  name           String   @db.VarChar(60)
  description    String?
  isSystem       Boolean  @default(false)
  /// Permission keys granted by this role. Validated against the Permission catalog.
  permissions    String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  email           String           @db.Citext
  roleId          String           @db.Uuid
  /// SHA-256 of the raw token sent to the invitee. The raw token is never stored.
  tokenHash       String           @unique
  status          InvitationStatus @default(pending)
  invitedByUserId String           @db.Uuid
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, email, status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Auth tokens
// ---------------------------------------------------------------------------

/// Opaque refresh tokens with rotation. `familyId` groups all tokens issued from one login (a session).
/// Reuse of an already-rotated token revokes the entire family.
model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  familyId          String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ipAddress         String?   @db.VarChar(64)
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum IdentityProvider {
  google
  microsoft
  facebook
  github
}

/// A sign-in identity at an external provider ("Continue with Google"), linked to one user.
model UserIdentity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  provider       IdentityProvider
  /// The provider's stable account id (OIDC `sub`, GitHub/Facebook numeric id) — never the email.
  providerUserId String           @db.VarChar(255)
  email          String?          @db.Citext
  createdAt      DateTime         @default(now())
  lastLoginAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit, billing, usage
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String   @db.VarChar(100)
  targetType     String?  @db.VarChar(60)
  targetId       String?  @db.VarChar(64)
  metadata       Json     @default("{}")
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?
  requestId      String?  @db.VarChar(64)
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
}

enum PlanKey {
  free
  starter
  pro
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @db.Uuid
  plan                   PlanKey            @default(free)
  status                 SubscriptionStatus @default(active)
  /// Snapshot of plan limits at subscription time (allows per-customer overrides).
  limits                 Json
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  provider               String?            @db.VarChar(40)
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum UsageMetric {
  ai_tokens
  agent_executions
  documents
  storage_mb
  automation_runs
}

model UsageRecord {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  userId         String?     @db.Uuid
  metric         UsageMetric
  quantity       BigInt
  periodStart    DateTime
  periodEnd      DateTime
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, metric, periodStart])
  @@index([userId])
}

/// Per-organization monthly AI budget (tokens and/or USD). Cost can only be enforced where model pricing is configured.
model OrganizationBudget {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @unique @db.Uuid
  monthlyTokenBudget   BigInt?
  monthlyCostBudgetUsd Decimal? @db.Decimal(14, 4)
  /// Percentage (1-100) of a budget at which a warning alert is raised.
  warnThresholdPct     Int      @default(80)
  /// When true, AI requests are refused (402 BUDGET_EXCEEDED) once the budget is used up.
  hardStopEnabled      Boolean  @default(false)
  updatedById          String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum BudgetAlertScope {
  budget_tokens
  budget_cost
  plan_tokens
}

enum BudgetAlertKind {
  warning
  exceeded
}

/// One row per (organization, month, scope, kind): the first time a threshold is crossed in a period.
model BudgetAlert {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  periodStart    DateTime
  scope          BudgetAlertScope
  kind           BudgetAlertKind
  used           Decimal          @db.Decimal(20, 6)
  limit          Decimal          @db.Decimal(20, 6)
  thresholdPct   Int
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart, scope, kind])
  @@index([organizationId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// CRM: contacts, leads, conversations
// ---------------------------------------------------------------------------

model Contact {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  firstName      String    @db.VarChar(80)
  lastName       String?   @db.VarChar(80)
  email          String?   @db.Citext
  phone          String?   @db.VarChar(32)
  company        String?   @db.VarChar(120)
  jobTitle       String?   @db.VarChar(120)
  tags           String[]  @default([])
  notes          String?
  customFields   Json      @default("{}")
  ownerId        String?   @db.Uuid
  /// Optional link to a Company record (the free-text `company` column stays for quick entry/imports).
  companyId      String?   @db.Uuid
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  companyRef    Company?       @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  leads         Lead[]
  conversations Conversation[]
  tasks         Task[]
  deals         Deal[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([ownerId])
  @@index([companyId])
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  won
  lost
}

enum LeadSource {
  website
  referral
  social
  email
  phone
  whatsapp
  event
  ai_assistant
  import
  other
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  title             String     @db.VarChar(160)
  status            LeadStatus @default(new)
  source            LeadSource @default(other)
  value             Decimal?   @db.Decimal(14, 2)
  currency          String     @default("USD") @db.Char(3)
  contactId         String?    @db.Uuid
  assigneeId        String?    @db.Uuid
  description       String?
  tags              String[]   @default([])
  customFields      Json       @default("{}")
  expectedCloseDate DateTime?
  convertedAt       DateTime?
  lostReason        String?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes         LeadNote[]
  activities    LeadActivity[]
  conversations Conversation[]
  tasks         Task[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, assigneeId])
  @@index([organizationId, deletedAt])
  @@index([contactId])
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  actorId   String?  @db.Uuid
  type      String   @db.VarChar(40)
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

enum ConversationStatus {
  open
  pending
  resolved
  archived
}

enum ConversationChannel {
  web
  email
  whatsapp
  phone
  internal
  api
}

enum MessageRole {
  customer
  agent
  assistant
  system
}

model Conversation {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  subject        String?             @db.VarChar(200)
  status         ConversationStatus  @default(open)
  channel        ConversationChannel @default(internal)
  contactId      String?             @db.Uuid
  leadId         String?             @db.Uuid
  assigneeId     String?             @db.Uuid
  /// AI-generated summary, refreshed asynchronously by workers.
  summary        String?
  lastMessageAt  DateTime?
  messageCount   Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages     Message[]
  tasks        Task[]

  @@index([organizationId, status, lastMessageAt(sort: Desc)])
  @@index([organizationId, assigneeId])
  @@index([contactId])
  @@index([leadId])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  authorUserId   String?     @db.Uuid
  content        String
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  userId         String    @db.Uuid
  type           String    @db.VarChar(60)
  title          String    @db.VarChar(200)
  body           String?
  link           String?
  data           Json      @default("{}")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// AI platform: provider configuration, usage, prompts, assistant, agents
// ---------------------------------------------------------------------------

enum AiProviderKind {
  anthropic
  openai
  bedrock
  mock
}

enum AiHealthStatus {
  unknown
  ok
  error
}

/// Organization-level AI provider credentials and defaults. `encryptedApiKey` is AES-256-GCM
/// (APP_ENCRYPTION_KEY); only `keyLast4` ever leaves the API.
model AiProviderConfig {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  provider          AiProviderKind
  name              String         @db.VarChar(80)
  encryptedApiKey   String?
  keyLast4          String?        @db.VarChar(4)
  baseUrl           String?
  /// AWS region (bedrock only). Null = use the server's AWS region chain.
  region            String?        @db.VarChar(40)
  defaultModel      String         @db.VarChar(120)
  embeddingModel    String?        @db.VarChar(120)
  isDefault         Boolean        @default(false)
  isEnabled         Boolean        @default(true)
  lastHealthStatus  AiHealthStatus @default(unknown)
  lastHealthCheckAt DateTime?
  lastHealthError   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       Agent[]
  threads      AssistantThread[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
}

enum AiOperation {
  generate
  stream
  structured
  embed
}

enum AiRequestStatus {
  success
  error
  timeout
  cancelled
}

/// One row per model call. Cost is only filled when pricing configuration exists for the model.
model AiRequestLog {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  userId           String?         @db.Uuid
  agentId          String?         @db.Uuid
  executionId      String?         @db.Uuid
  threadId         String?         @db.Uuid
  provider         AiProviderKind
  model            String          @db.VarChar(120)
  operation        AiOperation
  status           AiRequestStatus
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  durationMs       Int             @default(0)
  estimatedCostUsd Decimal?        @db.Decimal(12, 6)
  errorCode        String?         @db.VarChar(60)
  errorMessage     String?
  metadata         Json            @default("{}")
  createdAt        DateTime        @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent        Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  execution    AgentExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, agentId])
  @@index([executionId])
}

/// Reusable prompt templates with `{{variable}}` placeholders.
model PromptTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String   @db.VarChar(80)
  name           String   @db.VarChar(120)
  description    String?
  content        String
  variables      String[] @default([])
  isSystem       Boolean  @default(false)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

/// Interactive assistant conversation between one user and the AI (distinct from customer `Conversation`).
model AssistantThread {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  userId           String    @db.Uuid
  title            String?   @db.VarChar(200)
  providerConfigId String?   @db.Uuid
  model            String?   @db.VarChar(120)
  /// Rolling summary of older messages that fell out of the context window.
  summary          String?
  summarizedUpTo   DateTime?
  messageCount     Int       @default(0)
  lastMessageAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig AiProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  messages       AssistantMessage[]

  @@index([organizationId, userId, lastMessageAt(sort: Desc)])
}

enum AssistantRole {
  user
  assistant
  system
  tool
}

model AssistantMessage {
  id           String        @id @default(uuid()) @db.Uuid
  threadId     String        @db.Uuid
  role         AssistantRole
  content      String
  /// Tool calls requested by the assistant: [{ id, name, input }]
  toolCalls    Json?
  /// For role=tool: the id of the tool call this message answers.
  toolCallId   String?       @db.VarChar(120)
  toolName     String?       @db.VarChar(120)
  inputTokens  Int?
  outputTokens Int?
  metadata     Json          @default("{}")
  createdAt    DateTime      @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model Agent {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  name             String   @db.VarChar(120)
  description      String?
  instructions     String
  providerConfigId String?  @db.Uuid
  model            String?  @db.VarChar(120)
  temperature      Float?
  maxOutputTokens  Int?
  /// Tool keys from the tool registry this agent may call.
  tools            String[] @default([])
  /// Permission grants for tool execution: { allowWrite: boolean, allowDelegation: boolean, delegateTo: string[] }
  permissions      Json     @default("{}")
  knowledgeBaseIds String[] @default([]) @db.Uuid
  maxSteps         Int      @default(12)
  maxDurationMs    Int      @default(120000)
  maxTokens        Int      @default(150000)
  maxDelegations   Int      @default(3)
  retryPolicy      Json     @default("{\"maxAttempts\":2,\"backoffMs\":2000}")
  isEnabled        Boolean  @default(true)
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig AiProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("AgentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  executions     AgentExecution[]
  requestLogs    AiRequestLog[]
  evaluationRuns EvaluationRun[]

  @@unique([organizationId, name])
  @@index([organizationId, isEnabled])
}

enum AgentExecutionStatus {
  queued
  running
  succeeded
  failed
  timed_out
  cancelled
}

enum AgentTrigger {
  manual
  api
  automation
  agent
  schedule
}

model AgentExecution {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  agentId           String               @db.Uuid
  parentExecutionId String?              @db.Uuid
  rootExecutionId   String?              @db.Uuid
  triggeredByUserId String?              @db.Uuid
  trigger           AgentTrigger         @default(manual)
  status            AgentExecutionStatus @default(queued)
  input             Json
  output            Json?
  error             String?
  depth             Int                  @default(0)
  stepCount         Int                  @default(0)
  inputTokens       Int                  @default(0)
  outputTokens      Int                  @default(0)
  estimatedCostUsd  Decimal?             @db.Decimal(12, 6)
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parent       AgentExecution?      @relation("ExecutionTree", fields: [parentExecutionId], references: [id], onDelete: SetNull)
  children     AgentExecution[]     @relation("ExecutionTree")
  triggeredBy  User?                @relation("ExecutionTrigger", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  steps        AgentExecutionStep[]
  requestLogs  AiRequestLog[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, agentId, status])
  @@index([parentExecutionId])
  @@index([rootExecutionId])
}

enum AgentStepType {
  llm_call
  tool_call
  delegation
  final
  error
}

model AgentExecutionStep {
  id           String        @id @default(uuid()) @db.Uuid
  executionId  String        @db.Uuid
  index        Int
  type         AgentStepType
  name         String?       @db.VarChar(120)
  input        Json?
  output       Json?
  status       String        @default("succeeded") @db.VarChar(20)
  error        String?
  durationMs   Int?
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime      @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, index])
}

// ---------------------------------------------------------------------------
// Knowledge base & RAG
// ---------------------------------------------------------------------------

/// A collection of documents searchable together. Embeddings are produced by the configured
/// embedding-capable provider; all vectors are normalised to EMBEDDING_DIMENSIONS (1536) so one
/// HNSW index serves every organization.
model KnowledgeBase {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @db.Uuid
  name                      String   @db.VarChar(120)
  description               String?
  embeddingProviderConfigId String?  @db.Uuid
  embeddingModel            String?  @db.VarChar(120)
  documentCount             Int      @default(0)
  chunkCount                Int      @default(0)
  createdById               String?  @db.Uuid
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    Document[]
  chunks       DocumentChunk[]

  @@unique([organizationId, name])
}

enum DocumentStatus {
  uploaded
  processing
  ready
  failed
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  knowledgeBaseId String         @db.Uuid
  title           String         @db.VarChar(255)
  fileName        String         @db.VarChar(255)
  mimeType        String         @db.VarChar(120)
  sizeBytes       Int
  /// Key in the object storage abstraction (local disk or S3-compatible). Never a public URL.
  storageKey      String         @unique
  checksum        String?        @db.VarChar(64)
  status          DocumentStatus @default(uploaded)
  error           String?
  pageCount       Int?
  chunkCount      Int            @default(0)
  metadata        Json           @default("{}")
  uploadedById    String?        @db.Uuid
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]

  @@index([organizationId, knowledgeBaseId, status])
  @@index([organizationId, createdAt(sort: Desc)])
}

/// Text chunk with its embedding. `embedding` is pgvector (vector(1536)); read/written with raw SQL.
model DocumentChunk {
  id              String                       @id @default(uuid()) @db.Uuid
  organizationId  String                       @db.Uuid
  knowledgeBaseId String                       @db.Uuid
  documentId      String                       @db.Uuid
  index           Int
  content         String
  tokenCount      Int                          @default(0)
  embedding       Unsupported("vector(1536)")?
  metadata        Json                         @default("{}")
  createdAt       DateTime                     @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([organizationId, knowledgeBaseId])
}

// ---------------------------------------------------------------------------
// Automation: workflows, inbound webhooks, outbound webhooks, integrations
// ---------------------------------------------------------------------------

/// Workflow definition. `trigger` and `steps` are validated by the API with the contracts schemas.
model Workflow {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(120)
  description    String?
  isEnabled      Boolean   @default(true)
  trigger        Json
  steps          Json
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   WorkflowExecution[]
  endpoints    WebhookEndpoint[]

  @@unique([organizationId, name])
  @@index([organizationId, isEnabled])
}

enum WorkflowRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

model WorkflowExecution {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  workflowId     String            @db.Uuid
  status         WorkflowRunStatus @default(queued)
  /// { type: manual|webhook|schedule|event, event?, actorUserId?, endpointId? }
  trigger        Json
  input          Json
  output         Json?
  error          String?
  /// Per-step results: [{ stepId, type, status, output?, error?, durationMs }]
  stepResults    Json              @default("[]")
  attempt        Int               @default(1)
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId, workflowId, createdAt(sort: Desc)])
  @@index([organizationId, status])
}

/// Inbound webhook URL that triggers a workflow. The secret is stored hashed (SHA-256).
model WebhookEndpoint {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  workflowId     String?   @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @db.VarChar(64)
  secretHash     String    @db.VarChar(64)
  isEnabled      Boolean   @default(true)
  receivedCount  Int       @default(0)
  lastReceivedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@unique([organizationId, slug])
}

/// Outbound webhook subscription (events → external URL, HMAC-signed).
model Webhook {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  url             String
  description     String?
  events          String[] @default([])
  /// Encrypted signing secret (SecretBox); clients get only its last 4 characters.
  encryptedSecret String
  secretLast4     String   @db.VarChar(4)
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, isEnabled])
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
}

model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  webhookId      String                @db.Uuid
  event          String                @db.VarChar(80)
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  responseStatus Int?
  responseBody   String?
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([organizationId, webhookId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt(sort: Desc)])
}

enum IntegrationKind {
  email
  whatsapp
  crm
  rest
  n8n
}

enum IntegrationStatus {
  unconfigured
  connected
  error
}

/// External system connection. Non-secret settings in `config`; credentials encrypted in `encryptedSecrets`.
model Integration {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  kind             IntegrationKind
  name             String            @db.VarChar(120)
  config           Json              @default("{}")
  encryptedSecrets String?
  isEnabled        Boolean           @default(true)
  status           IntegrationStatus @default(unconfigured)
  lastCheckedAt    DateTime?
  lastError        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, name])
}

// ---------------------------------------------------------------------------
// Tasks (to-dos with reminders), companies, pipelines and deals, CSV import jobs
// ---------------------------------------------------------------------------

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskSource {
  human
  ai
  automation
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String       @db.VarChar(200)
  description    String?
  status         TaskStatus   @default(todo)
  priority       TaskPriority @default(medium)
  dueAt          DateTime?
  reminderAt     DateTime?
  /// Set by the reminder job when the reminder notification has been created (idempotency marker).
  reminderSentAt DateTime?
  completedAt    DateTime?
  assigneeId     String?      @db.Uuid
  createdById    String?      @db.Uuid
  source         TaskSource   @default(human)
  /// Polymorphic related entity: at most one is normally set, all are nullable FKs.
  leadId         String?      @db.Uuid
  contactId      String?      @db.Uuid
  dealId         String?      @db.Uuid
  conversationId String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([reminderAt])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@index([conversationId])
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(160)
  domain         String?  @db.VarChar(160)
  notes          String?
  tags           String[] @default([])
  ownerId        String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]    @relation("CompanyContacts")
  deals        Deal[]

  @@index([organizationId, name])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([ownerId])
}

enum StageKind {
  open
  won
  lost
}

enum DealStatus {
  open
  won
  lost
}

model Pipeline {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(120)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
}

model PipelineStage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  pipelineId     String    @db.Uuid
  name           String    @db.VarChar(80)
  /// 0-based position inside the pipeline; kept contiguous by the API.
  order          Int
  /// Win probability 0-100 used for weighted pipeline value.
  probability    Int       @default(0)
  kind           StageKind @default(open)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([pipelineId, name])
  @@index([organizationId])
  @@index([pipelineId, order])
}

model Deal {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  title           String     @db.VarChar(200)
  description     String?
  value           Decimal?   @db.Decimal(14, 2)
  currency        String     @default("USD") @db.Char(3)
  pipelineId      String     @db.Uuid
  stageId         String     @db.Uuid
  /// Denormalised from the stage kind so reports and indexes do not need a join.
  status          DealStatus @default(open)
  /// Order of the card inside its stage column (0 = top); kept contiguous per stage by the API.
  position        Int        @default(0)
  ownerId         String?    @db.Uuid
  contactId       String?    @db.Uuid
  companyId       String?    @db.Uuid
  expectedCloseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  tags            String[]   @default([])
  stageEnteredAt  DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage        PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner        User?             @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notes        DealNote[]
  activities   DealActivity[]
  stageChanges DealStageChange[]
  tasks        Task[]

  @@index([organizationId, pipelineId, stageId, position])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([contactId])
  @@index([companyId])
  @@index([stageId])
}

model DealNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  dealId         String   @db.Uuid
  authorId       String   @db.Uuid
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt(sort: Desc)])
  @@index([organizationId])
}

model DealActivity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  dealId         String   @db.Uuid
  actorId        String?  @db.Uuid
  type           String   @db.VarChar(40)
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt(sort: Desc)])
  @@index([organizationId])
}

/// One row per stage entry (creation included: fromStageId is null). Feeds stage-conversion reporting.
model DealStageChange {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  dealId         String   @db.Uuid
  pipelineId     String   @db.Uuid
  fromStageId    String?  @db.Uuid
  toStageId      String   @db.Uuid
  actorId        String?  @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
  @@index([organizationId, pipelineId, toStageId])
}

enum ImportEntity {
  contacts
  leads
  companies
  deals
}

enum ImportStatus {
  uploaded
  validated
  queued
  running
  completed
  failed
  cancelled
}

model ImportJob {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  entity         ImportEntity
  status         ImportStatus @default(uploaded)
  fileName       String       @db.VarChar(255)
  sizeBytes      Int
  storageKey     String
  checksum       String?      @db.VarChar(64)
  encoding       String?      @db.VarChar(32)
  delimiter      String?      @db.VarChar(8)
  headers        Json         @default("[]")
  totalRows      Int          @default(0)
  mapping        Json?
  /// skip | update | create
  duplicateStrategy String    @default("skip") @db.VarChar(16)
  /// Result of the last dry run: counts and (capped) per-row problems.
  validation     Json?
  processedRows  Int          @default(0)
  createdCount   Int          @default(0)
  updatedCount   Int          @default(0)
  skippedCount   Int          @default(0)
  failedCount    Int          @default(0)
  /// Capped list of skipped/failed rows with reasons: [{ row, status, reason }]
  report         Json         @default("[]")
  error          String?
  createdById    String?      @db.Uuid
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status])
}

// ---------------------------------------------------------------------------
// Agent evaluation (datasets, cases, runs, per-case results)
// ---------------------------------------------------------------------------

model EvaluationDataset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(120)
  description    String?
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases        EvaluationCase[]
  runs         EvaluationRun[]

  @@index([organizationId, createdAt(sort: Desc)])
}

model EvaluationCase {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  datasetId      String   @db.Uuid
  name           String   @db.VarChar(160)
  input          String
  /// Array of `{ type, value }` checks; a case passes when every check passes.
  checks         Json
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dataset EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results EvaluationResult[]

  @@index([organizationId, datasetId, position])
}

enum EvaluationRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

model EvaluationRun {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  datasetId         String              @db.Uuid
  agentId           String              @db.Uuid
  status            EvaluationRunStatus @default(queued)
  totalCases        Int                 @default(0)
  passed            Int                 @default(0)
  failed            Int                 @default(0)
  errored           Int                 @default(0)
  error             String?
  triggeredByUserId String?             @db.Uuid
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  results      EvaluationResult[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, datasetId, createdAt(sort: Desc)])
}

enum EvaluationResultStatus {
  passed
  failed
  error
}

model EvaluationResult {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  runId          String                 @db.Uuid
  caseId         String?                @db.Uuid
  /// Snapshot of the case at run time, so results stay readable after the case is edited or deleted.
  caseName       String                 @db.VarChar(160)
  input          String
  status         EvaluationResultStatus
  output         String?
  error          String?
  /// Array of `{ type, value, passed }`.
  checks         Json
  executionId    String?                @db.Uuid
  durationMs     Int?
  createdAt      DateTime               @default(now())

  run  EvaluationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  case EvaluationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([runId, caseId])
  @@index([organizationId, runId])
}
