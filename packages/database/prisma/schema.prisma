// HilaTech AI Assistant — relational schema (PostgreSQL + pgvector)
//
// Conventions
//  - Every organization-owned table has `organizationId` (NOT NULL, indexed, FK → Organization, cascade).
//  - IDs are UUIDs generated by the database.
//  - `createdAt` / `updatedAt` on every mutable entity.
//  - Soft deletion only where justified (Organization, Lead, Contact) via `deletedAt`.
//  - Tenant isolation is enforced in the API layer (TenantContext + repositories); these constraints are
//    the second line of defence.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  runtime  = "nodejs"
  moduleFormat = "cjs"
  generatedFileExtension = "ts"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String
  firstName       String    @db.VarChar(80)
  lastName        String    @db.VarChar(80)
  avatarUrl       String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true)
  /// UI/user preferences (theme, locale, notification preferences). Validated by the API.
  preferences     Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             OrganizationMember[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         Invitation[]             @relation("InvitationInviter")
  auditLogs               AuditLog[]
  notifications           Notification[]
  ownedContacts           Contact[]                @relation("ContactOwner")
  assignedLeads           Lead[]                   @relation("LeadAssignee")
  leadNotes               LeadNote[]
  assignedConversations   Conversation[]           @relation("ConversationAssignee")
  messages                Message[]
  usageRecords            UsageRecord[]

  @@index([isActive])
}

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(50)
  industry    String?   @db.VarChar(100)
  timezone    String    @default("UTC") @db.VarChar(64)
  locale      String    @default("en") @db.VarChar(16)
  logoUrl     String?
  website     String?
  description String?
  /// Organization-specific settings (business hours, branding, AI defaults). Validated by the API.
  settings    Json      @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members       OrganizationMember[]
  roles         Role[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  usageRecords  UsageRecord[]
  contacts      Contact[]
  leads         Lead[]
  conversations Conversation[]
  notifications Notification[]

  @@index([deletedAt])
}

enum MemberStatus {
  active
  suspended
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  status         MemberStatus @default(active)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@index([roleId])
}

/// Catalog of permission keys (`resource:action`). Seeded from @hilatech/contracts; used for validation and UI.
model Permission {
  key         String   @id @db.VarChar(80)
  group       String   @db.VarChar(40)
  description String?
  createdAt   DateTime @default(now())
}

/// Roles are per-organization. System roles (owner/admin/member) are created with the organization.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String   @db.VarChar(40)
  name           String   @db.VarChar(60)
  description    String?
  isSystem       Boolean  @default(false)
  /// Permission keys granted by this role. Validated against the Permission catalog.
  permissions    String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  email           String           @db.Citext
  roleId          String           @db.Uuid
  /// SHA-256 of the raw token sent to the invitee. The raw token is never stored.
  tokenHash       String           @unique
  status          InvitationStatus @default(pending)
  invitedByUserId String           @db.Uuid
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, email, status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Auth tokens
// ---------------------------------------------------------------------------

/// Opaque refresh tokens with rotation. `familyId` groups all tokens issued from one login (a session).
/// Reuse of an already-rotated token revokes the entire family.
model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  familyId          String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ipAddress         String?   @db.VarChar(64)
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit, billing, usage
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String   @db.VarChar(100)
  targetType     String?  @db.VarChar(60)
  targetId       String?  @db.VarChar(64)
  metadata       Json     @default("{}")
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?
  requestId      String?  @db.VarChar(64)
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
}

enum PlanKey {
  free
  starter
  pro
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @db.Uuid
  plan                   PlanKey            @default(free)
  status                 SubscriptionStatus @default(active)
  /// Snapshot of plan limits at subscription time (allows per-customer overrides).
  limits                 Json
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  provider               String?            @db.VarChar(40)
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum UsageMetric {
  ai_tokens
  agent_executions
  documents
  storage_mb
  automation_runs
}

model UsageRecord {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  userId         String?     @db.Uuid
  metric         UsageMetric
  quantity       BigInt
  periodStart    DateTime
  periodEnd      DateTime
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, metric, periodStart])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CRM: contacts, leads, conversations
// ---------------------------------------------------------------------------

model Contact {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  firstName      String    @db.VarChar(80)
  lastName       String?   @db.VarChar(80)
  email          String?   @db.Citext
  phone          String?   @db.VarChar(32)
  company        String?   @db.VarChar(120)
  jobTitle       String?   @db.VarChar(120)
  tags           String[]  @default([])
  notes          String?
  customFields   Json      @default("{}")
  ownerId        String?   @db.Uuid
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads         Lead[]
  conversations Conversation[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([ownerId])
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  won
  lost
}

enum LeadSource {
  website
  referral
  social
  email
  phone
  whatsapp
  event
  ai_assistant
  import
  other
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  title             String     @db.VarChar(160)
  status            LeadStatus @default(new)
  source            LeadSource @default(other)
  value             Decimal?   @db.Decimal(14, 2)
  currency          String     @default("USD") @db.Char(3)
  contactId         String?    @db.Uuid
  assigneeId        String?    @db.Uuid
  description       String?
  tags              String[]   @default([])
  customFields      Json       @default("{}")
  expectedCloseDate DateTime?
  convertedAt       DateTime?
  lostReason        String?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignee      User?          @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes         LeadNote[]
  activities    LeadActivity[]
  conversations Conversation[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, assigneeId])
  @@index([organizationId, deletedAt])
  @@index([contactId])
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  actorId   String?  @db.Uuid
  type      String   @db.VarChar(40)
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

enum ConversationStatus {
  open
  pending
  resolved
  archived
}

enum ConversationChannel {
  web
  email
  whatsapp
  phone
  internal
  api
}

enum MessageRole {
  customer
  agent
  assistant
  system
}

model Conversation {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  subject        String?             @db.VarChar(200)
  status         ConversationStatus  @default(open)
  channel        ConversationChannel @default(internal)
  contactId      String?             @db.Uuid
  leadId         String?             @db.Uuid
  assigneeId     String?             @db.Uuid
  /// AI-generated summary, refreshed asynchronously by workers.
  summary        String?
  lastMessageAt  DateTime?
  messageCount   Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@index([organizationId, status, lastMessageAt(sort: Desc)])
  @@index([organizationId, assigneeId])
  @@index([contactId])
  @@index([leadId])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  authorUserId   String?     @db.Uuid
  content        String
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  userId         String    @db.Uuid
  type           String    @db.VarChar(60)
  title          String    @db.VarChar(200)
  body           String?
  link           String?
  data           Json      @default("{}")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([organizationId])
}
