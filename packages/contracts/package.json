{
  "name": "@hilatech/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API contracts: zod schemas, DTO types, permission keys, queue names, error codes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@hilatech/config": "workspace:*",
    "eslint": "9.39.5",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
