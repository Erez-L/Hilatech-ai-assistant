{
  "name": "@hilatech/storage",
  "version": "0.1.0",
  "private": true,
  "description": "Object storage abstraction (local disk, S3-compatible) for uploaded documents and generated files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@hilatech/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
