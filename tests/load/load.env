# Overrides applied on top of the repo .env for the LOAD-TEST stack ONLY (sourced by stack.sh).
# Separate DB, separate Redis db + BullMQ prefix, separate ports. No code defaults are changed:
# the rate-limit variables below are the documented env knobs (env.schema.ts) and are raised only here
# because every virtual user shares one source IP (127.0.0.1), which a per-IP limiter would count as one client.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hilatech_load?schema=public
REDIS_URL=redis://localhost:6379/7
BULLMQ_PREFIX=bull-load
API_PORT=4150
API_URL=http://localhost:4150
WORKERS_HEALTH_PORT=4151
LOG_LEVEL=warn
AI_ALLOW_MOCK_PROVIDER=true
RATE_LIMIT_MAX=100000000
AUTH_RATE_LIMIT_MAX=100000000
WEBHOOK_RATE_LIMIT_MAX=100000000
