# ---------------------------------------------------------------------------
# HilaTech AI Assistant — environment configuration
# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- URLs -------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Database & cache -------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hilatech?schema=public
REDIS_URL=redis://localhost:6379
# Max Postgres connections per API / workers process (total = processes x this; keep below the DB max_connections)
DB_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL=1h
EMAIL_VERIFICATION_TTL=24h
INVITATION_TTL=7d
# Set to "true" behind HTTPS so the refresh cookie is marked Secure
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Workers ----------------------------------------------------------------
WORKERS_HEALTH_PORT=4100
WORKER_CONCURRENCY=5
BULLMQ_PREFIX=bull
SHUTDOWN_TIMEOUT_SECONDS=30

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Email (abstracted; "log" driver prints emails to stdout) --------------
EMAIL_DRIVER=log            # log | smtp
EMAIL_FROM="HilaTech AI Assistant <no-reply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- File storage (abstracted) ---------------------------------------------
STORAGE_DRIVER=local        # local | s3
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25

# --- AI providers (optional; features degrade gracefully when unset) -------
# Organization-level keys are stored encrypted in the database. These are platform defaults.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Amazon Bedrock (optional). Uses the AWS default credential chain - NO access keys in this file.
# Local dev: run `aws sso login --profile <profile>` and set AWS_PROFILE; deployed: the ECS task role is used.
# Bedrock calls are made with the SERVER's AWS identity and billed to that AWS account, so it is off by default.
# See docs/operations/aws-setup-guide.md.
AI_BEDROCK_ENABLED=false
AWS_PROFILE=
AWS_REGION=
# 32-byte base64 key used to encrypt organization AI credentials at rest: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Allow the deterministic in-process "mock" provider (development/tests only; refused in production)
AI_ALLOW_MOCK_PROVIDER=false
# Optional pricing table for cost estimates (USD per 1M tokens). Without it, estimatedCostUsd is null — never guessed.
# Example: [{"provider":"openai","model":"gpt-4o-mini","inputPerMillionUsd":0.15,"outputPerMillionUsd":0.6}]
AI_PRICING_JSON=
# Per-tool-call timeout inside agent executions
AI_TOOL_TIMEOUT_MS=15000

# --- Automation -------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_API_KEY=

# --- Frontend (public) ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
